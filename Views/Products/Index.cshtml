@model IEnumerable<Laptop.Models.Product>

@functions {
    public string ResolveProductImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            return Url.Content("~/images/no-image.jpg");
        }

        if (imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) || imagePath.StartsWith("/"))
        {
            return imagePath;
        }

        return Url.Content("~/" + imagePath.TrimStart('/'));
    }
}

@{
    ViewData["Title"] = L["Shop"];

    var searchTerm = Context.Request.Query["search"].ToString().ToLower().Trim();
    var minPrice = decimal.TryParse(Context.Request.Query["minPrice"], out var minP) ? minP : 0;
    var priceLimit = Formatter.DisplayPriceLimit;
    var maxPrice = decimal.TryParse(Context.Request.Query["maxPrice"], out var maxP) ? maxP : priceLimit;
    var selectedConditions = Context.Request.Query["condition"].ToList();
    var selectedBrands = Context.Request.Query["brand"].ToList();
    var sortBy = Context.Request.Query["sort"].ToString().ToLower();
    var specificationFilterGroups = new (string Key, string Label, string[] Options)[]
    {
        ("storage", "FilterStorage", new[] { "256GB", "512GB", "1TB", "2TB", "128GB" }),
        ("usage", "FilterUsage", new[] { "Study - Office", "thin and light", "High-end", "Graphics", "Content creation" }),
        ("ram", "FilterRam", new[] { "4GB", "8GB", "16GB", "24GB", "32GB", "64GB", "128GB" }),
        ("cpu", "FilterCpu", new[] { "Intel Core i3", "Intel Core i5", "Intel Core i7", "AMD Ryzen 5", "AMD Ryzen 9", "AMD Ryzen 7", "Intel Celeron", "AMD Ryzen AI", "Intel Core U9", "Intel Core U7", "Core 5", "Core 7", "Core 3", "Intel Core U5", "Qualcomm Snapdragon", "Snapdragon X Plus" }),
        ("screenSize", "FilterScreenSize", new[] { "Approximately 14 inches", "Approximately 13 inches", "Approximately 15 inches", "Approximately 16 inches", "Over 16 inches" }),
        ("resolution", "FilterResolution", new[] { "Full HD", "WQXGA", "WUXGA", "HD", "2K", "3K", "4K" }),
        ("graphics", "FilterGraphics", new[] { "Onboard", "NVIDIA GeForce", "AMD Radeon" }),
        ("specialFeatures", "FilterSpecialFeatures", new[] { "Wi-Fi 6", "Fingerprint security", "Touch screen", "Facial recognition", "Ultra-thin bezels", "360-degree rotating and folding (2 in 1)", "Wi-Fi 7", "OLED screen", "MUX Switch" })
    };

    var finalProducts = Model.ToList();
    var featuredPromotions = ViewBag.FeaturedPromotions as List<Laptop.Models.ProductPromotion>
        ?? new List<Laptop.Models.ProductPromotion>();
}

<div class="shop-container">
    <main class="main-content shop-main">

        @if (featuredPromotions.Any())
        {
            <section class="promo-carousel" data-promo-carousel aria-label="@L["FeaturedOffers"]" aria-roledescription="carousel">
                <div class="promo-carousel-heading">
                    <div>
                        <span class="promo-eyebrow"><i class="fas fa-bolt"></i> @L["FeaturedOffers"]</span>
                        <p>@L["FeaturedOffersSubtitle"]</p>
                    </div>
                    <div class="promo-carousel-controls">
                        <button type="button" data-promo-prev aria-label="@L["PreviousSlide"]"><i class="fas fa-chevron-left"></i></button>
                        <button type="button" data-promo-next aria-label="@L["NextSlide"]"><i class="fas fa-chevron-right"></i></button>
                        <button type="button" data-promo-toggle data-pause-label="@L["PauseSlider"]" data-resume-label="@L["ResumeSlider"]" aria-pressed="false" aria-label="@L["PauseSlider"]"><i class="fas fa-pause"></i></button>
                    </div>
                </div>

                <div class="promo-carousel-slides" aria-live="off">
                    @for (var promoIndex = 0; promoIndex < featuredPromotions.Count; promoIndex++)
                    {
                        var promotion = featuredPromotions[promoIndex];
                        var firstPromoImage = promotion.Product.Images?
                            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                            .FirstOrDefault();
                        var promoImageSrc = string.IsNullOrWhiteSpace(firstPromoImage)
                            ? Url.Content("~/images/no-image.jpg")
                            : firstPromoImage.StartsWith("http", StringComparison.OrdinalIgnoreCase) || firstPromoImage.StartsWith("/")
                                ? firstPromoImage
                                : Url.Content("~/" + firstPromoImage.TrimStart('/'));
                        <a class="promo-slide @(promoIndex == 0 ? "is-active" : "")"
                           href="@Url.Action("Details", "Products", new { id = promotion.ProductId })"
                           data-promo-slide
                           aria-hidden="@(promoIndex == 0 ? "false" : "true")"
                           tabindex="@(promoIndex == 0 ? "0" : "-1")">
                            <div class="promo-slide-copy">
                                <h2>@promotion.Product.Title</h2>
                                <p>@promotion.Product.Model</p>
                                <div class="promo-slide-prices">
                                    <strong>@Formatter.Format(promotion.Product)</strong>
                                    <span class="promo-discount">@L["PromotionPercentOff", promotion.DiscountPercent.ToString("0.##")]</span>
                                    <del>@Formatter.Format(promotion.Product.Price, promotion.Product.Currency)</del>
                                </div>
                                <span class="promo-slide-cta">@L["ViewLaptopDeal"] <i class="fas fa-arrow-right"></i></span>
                            </div>
                            <div class="promo-slide-image-wrap">
                                <img src="@promoImageSrc" alt="@promotion.Product.Title" />
                            </div>
                        </a>
                    }
                </div>

                <div class="promo-carousel-dots" role="group" aria-label="@L["FeaturedOffers"]">
                    @for (var promoIndex = 0; promoIndex < featuredPromotions.Count; promoIndex++)
                    {
                        <button type="button" data-promo-dot="@promoIndex" class="@(promoIndex == 0 ? "is-active" : "")"
                                aria-label="@L["ViewLaptopDeal"] @(promoIndex + 1) / @featuredPromotions.Count"
                                aria-current="@(promoIndex == 0 ? "true" : "false")"></button>
                    }
                </div>
            </section>
        }

        <div class="shop-top-bar">
            <div class="results-count">@L["ProductsFound", finalProducts.Count()]</div>

            <div class="shop-toolbar-actions">
                <div class="sort-section">
                    <label>@L["SortBy"]</label>
                    <select id="sort-select" aria-label="@L["SortBy"]">
                        <option value="">@L["Featured"]</option>
                        <option value="price-low" selected="@(sortBy == "price-low")">@L["PriceLowToHigh"]</option>
                        <option value="price-high" selected="@(sortBy == "price-high")">@L["PriceHighToLow"]</option>
                        <option value="newest" selected="@(sortBy == "newest")">@L["NewestArrivals"]</option>
                    </select>
                </div>
                <button type="button" id="filter-toggle-button" class="shop-filter-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="specification-filter-popup" onclick="openSpecificationFilters()">
                    <i class="fas fa-sliders-h"></i> @L["Filter"]
                </button>
            </div>
        </div>

        <div class="shop-layout" id="shop-layout">
            <aside class="shop-filters" id="shop-filters">
                <section class="shop-filter-category">
                <h3>@L["PriceRange"]</h3>
                <div class="price-range">
                    <input type="range" id="price-slider" min="0" max="@priceLimit" step="@(Formatter.DisplayCurrency == "VND" ? "100000" : "100")"
                           value="@(maxPrice > 0 ? maxPrice : priceLimit)">
                    <div class="price-display" id="price-display">@Formatter.FormatDisplay(0) - @Formatter.FormatDisplay(maxPrice)</div>
                </div>

                </section>
                <section class="shop-filter-category">
                <h3>@L["Condition"]</h3>
                @foreach (var cond in new[] { "New", "Like New", "Used - Excellent", "Used - Good", "Used - Fair" })
                {
                    bool isChecked = selectedConditions.Contains(cond);
                    <label class="shop-filter-option">
                        <input class="filter-control" type="checkbox" name="condition" value="@cond"
                               @(isChecked ? "checked" : "")> @Formatter.TranslateCondition(cond)
                    </label>
                }

                </section>
                <section class="shop-filter-category">
                <h3>@L["Brands"]</h3>
                @foreach (var brand in new[] { "ASUS", "Acer", "Lenovo", "Dell", "HP", "Apple", "Samsung", "Microsoft", "MSI", "Razer" })
                {
                    bool isChecked = selectedBrands.Contains(brand);
                    <label class="shop-filter-option">
                        <input class="filter-control" type="checkbox" name="brand" value="@brand"
                               @(isChecked ? "checked" : "")> @brand
                    </label>
                }
                </section>
            </aside>

            <div class="shop-products">
                <div id="products-grid" class="shop-grid">
                    @if (!finalProducts.Any())
                    {
                        <div id="no-products">
                            <i class="fas fa-laptop" style="font-size:60px; opacity:0.4;"></i>
                            <h3>@L["NoProductsMatch"]</h3>
                        </div>
                    }
                    else
                    {
                        foreach (var product in finalProducts)
                        {
                            <div class="product-card" onclick="goToDetails(@product.Id, event)" style="cursor: pointer;">
                                <div class="product-image-container">
                                    @{
                                        var firstImage = product.Images?
                                            .Split(',')
                                            .Select(x => x.Trim())
                                            .FirstOrDefault(x => !string.IsNullOrEmpty(x));
                                    }

                                    <img src="@ResolveProductImage(firstImage)" alt="@product.Title" />
                                    <div class="condition condition-tag product-condition-tag">@Formatter.TranslateCondition(product.Condition)</div>
                                </div>

                                <div class="product-info">
                                    <h3>@product.Title</h3>
                                    <div class="model">@product.Model</div>
                                    @{
                                        var discountPercent = Formatter.GetActiveDiscountPercent(product);
                                    }
                                    <div class="price product-card-price">
                                        @if (discountPercent > 0)
                                        {
                                            <div class="sale-price-line">
                                                <strong>@Formatter.Format(product)</strong>
                                                <span class="product-sale-badge">@L["PromotionPercentOff", discountPercent.ToString("0.##")]
                                                </span>
                                            </div>
                                            <del>@Formatter.Format(product.Price, product.Currency)</del>
                                        }
                                        else
                                        {
                                            <span class="regular-product-price">@Formatter.Format(product)</span>
                                        }
                                    </div>
                                    <div class="seller">@L["Seller"]: @product.Seller</div>

                                    <div class="product-actions">
                                        <button type="button"
                                                onclick="addToCart(@product.Id, event);"
                                                class="add-to-cart-btn">
                                            <i class="fas fa-cart-plus"></i> @L["AddToCart"]
                                        </button>

                                        @if (ViewBag.Role == "Admin")
                                        {
                                            <form asp-action="DeleteConfirmed" method="post" style="display:inline;"
                                                  onclick="event.stopPropagation();"
                                                  class="confirm-delete-product-form">
                                                <input type="hidden" name="id" value="@product.Id" />
                                                <button type="submit" class="delete-product-btn" onclick="event.stopPropagation();">
                                                    <i class="fas fa-trash"></i> @L["Delete"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div id="specification-filter-popup" class="spec-filter-overlay" aria-hidden="true">
            <section class="spec-filter-dialog" role="dialog" aria-modal="true" aria-labelledby="spec-filter-title" tabindex="-1">
                <header class="spec-filter-header">
                    <h2 id="spec-filter-title">@L["Filter"]</h2>
                    <button type="button" class="spec-filter-close" onclick="closeSpecificationFilters()" aria-label="@L["Close"]">×</button>
                </header>
                <div class="spec-filter-content">
                    <div class="shop-filter-groups">
                @foreach (var group in specificationFilterGroups)
                {
                    <section class="shop-filter-category">
                        <h3>@L[group.Label]</h3>
                        @foreach (var option in group.Options)
                        {
                            var isChecked = Context.Request.Query[group.Key].Contains(option);
                            var optionKey = option.ToLowerInvariant().Replace(" ", "").Replace("-", "").Replace(":", "").Replace("(", "").Replace(")", "").Replace(".", "");
                            <label class="shop-filter-option">
                                <input class="filter-control" type="checkbox" name="@group.Key" value="@option" @(isChecked ? "checked" : "") />
                                @L[$"FilterOption_{optionKey}"]
                            </label>
                        }
                    </section>
                }
                </div>
                <div class="shop-filter-actions">
                    <button type="button" class="shop-filter-reset" onclick="resetFilters()">@L["ResetFilters"]</button>
                </div>
        </div>
        </section>
        </div>
    </main>
</div>

<script>
    const priceFilterUi = {
        locale: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Formatter.DisplayCurrency == "VND" ? "vi-VN" : "en-US")),
        currencySuffix: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Formatter.DisplayCurrency == "VND" ? " ₫" : " $")),
        minimum: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Formatter.FormatDisplay(0)))
    };

    function updatePriceDisplay(value) {
        const formattedValue = new Intl.NumberFormat(priceFilterUi.locale, {
            maximumFractionDigits: 0
        }).format(Number(value));
        document.getElementById("price-display").textContent = `${priceFilterUi.minimum} - ${formattedValue}${priceFilterUi.currencySuffix}`;
    }

    let filterRefreshTimer;
    let activeFilterRequest;

    function openSpecificationFilters() {
        const popup = document.getElementById('specification-filter-popup');
        popup.classList.add('is-open');
        popup.setAttribute('aria-hidden', 'false');
        document.body.classList.add('spec-filter-open');
        document.querySelector('.spec-filter-close')?.focus();
    }

    function closeSpecificationFilters() {
        const popup = document.getElementById('specification-filter-popup');
        popup.classList.remove('is-open');
        popup.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('spec-filter-open');
        document.getElementById('filter-toggle-button')?.focus();
    }

    function buildFilterUrl() {
        const params = new URLSearchParams();
        const search = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(searchTerm));
        if (search) params.set('search', search);
        params.set('minPrice', '0');
        params.set('maxPrice', document.getElementById('price-slider').value || '@priceLimit');
        document.querySelectorAll('.filter-control:checked').forEach(input => params.append(input.name, input.value));
        const sort = document.getElementById('sort-select').value;
        if (sort) params.set('sort', sort);
        return `/Products/Index?${params.toString()}`;
    }

    async function applyFilters() {
        clearTimeout(filterRefreshTimer);
        const url = buildFilterUrl();
        activeFilterRequest?.abort();
        activeFilterRequest = new AbortController();
        const grid = document.getElementById('products-grid');
        grid?.classList.add('is-filtering');
        try {
            const response = await fetch(url, { signal: activeFilterRequest.signal, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            if (!response.ok) throw new Error('Could not refresh products');
            const html = await response.text();
            const refreshedPage = new DOMParser().parseFromString(html, 'text/html');
            const refreshedGrid = refreshedPage.getElementById('products-grid');
            const refreshedCount = refreshedPage.querySelector('.results-count');
            if (refreshedGrid && grid) grid.innerHTML = refreshedGrid.innerHTML;
            if (refreshedCount) document.querySelector('.results-count').textContent = refreshedCount.textContent;
            history.replaceState({}, '', url);
            attachDeleteConfirmations();
        } catch (error) {
            if (error.name !== 'AbortError') console.error(error);
        } finally {
            grid?.classList.remove('is-filtering');
        }
    }

    function queueFilterRefresh(delay = 0) {
        clearTimeout(filterRefreshTimer);
        filterRefreshTimer = setTimeout(applyFilters, delay);
    }

    function resetFilters() {
        document.querySelectorAll('.filter-control').forEach(input => input.checked = false);
        const slider = document.getElementById('price-slider');
        slider.value = slider.max;
        updatePriceDisplay(slider.value);
        queueFilterRefresh();
    }

    function attachDeleteConfirmations() {
        document.querySelectorAll('.confirm-delete-product-form:not([data-confirm-bound])').forEach(form => {
            form.dataset.confirmBound = 'true';
            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                const confirmed = await showConfirm(
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteProductConfirmation"].Value)),
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteProduct"].Value))
                );
                if (confirmed) form.submit();
            });
        });
    }

    document.querySelectorAll('.filter-control').forEach(input => input.addEventListener('change', () => queueFilterRefresh()));
    document.getElementById('price-slider').addEventListener('input', function () {
        updatePriceDisplay(this.value);
        queueFilterRefresh(180);
    });
    document.getElementById('sort-select').addEventListener('change', () => queueFilterRefresh());
    document.getElementById('specification-filter-popup').addEventListener('click', function (event) {
        if (event.target === this) closeSpecificationFilters();
    });
    document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && document.getElementById('specification-filter-popup').classList.contains('is-open')) closeSpecificationFilters();
    });
    window.addEventListener('popstate', () => {
        // Reload the filtered listing state via the browser's normal navigation history.
        window.location.reload();
    });

    const promoCarousel = document.querySelector('[data-promo-carousel]');
    if (promoCarousel) {
        const promoSlides = [...promoCarousel.querySelectorAll('[data-promo-slide]')];
        const promoDots = [...promoCarousel.querySelectorAll('[data-promo-dot]')];
        const promoToggle = promoCarousel.querySelector('[data-promo-toggle]');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let activePromo = 0;
        let manuallyPaused = reducedMotion;
        let userEnabledMotion = false;
        let promoTimer;

        function showPromo(index) {
            activePromo = (index + promoSlides.length) % promoSlides.length;
            promoSlides.forEach((slide, itemIndex) => {
                const active = itemIndex === activePromo;
                slide.classList.toggle('is-active', active);
                slide.setAttribute('aria-hidden', String(!active));
                slide.tabIndex = active ? 0 : -1;
            });
            promoDots.forEach((dot, itemIndex) => {
                const active = itemIndex === activePromo;
                dot.classList.toggle('is-active', active);
                dot.setAttribute('aria-current', String(active));
            });
        }

        function canAutoAdvance() {
            return !manuallyPaused &&
                (!reducedMotion || userEnabledMotion) &&
                !document.hidden &&
                !promoCarousel.contains(document.activeElement);
        }

        function updatePromoTimer() {
            clearInterval(promoTimer);
            if (canAutoAdvance() && promoSlides.length > 1) {
                promoTimer = setInterval(() => showPromo(activePromo + 1), 4000);
            }
        }

        promoCarousel.querySelector('[data-promo-prev]')?.addEventListener('click', () => {
            showPromo(activePromo - 1);
            updatePromoTimer();
        });
        promoCarousel.querySelector('[data-promo-next]')?.addEventListener('click', () => {
            showPromo(activePromo + 1);
            updatePromoTimer();
        });
        promoDots.forEach(dot => dot.addEventListener('click', () => {
            showPromo(Number(dot.dataset.promoDot));
            updatePromoTimer();
        }));
        promoToggle?.addEventListener('click', () => {
            manuallyPaused = !manuallyPaused;
            if (!manuallyPaused) userEnabledMotion = true;
            promoToggle.setAttribute('aria-pressed', String(manuallyPaused));
            promoToggle.setAttribute('aria-label', manuallyPaused ? promoToggle.dataset.resumeLabel : promoToggle.dataset.pauseLabel);
            promoToggle.innerHTML = manuallyPaused ? '<i class="fas fa-play"></i>' : '<i class="fas fa-pause"></i>';
            updatePromoTimer();
        });
        promoCarousel.addEventListener('focusin', updatePromoTimer);
        promoCarousel.addEventListener('focusout', () => setTimeout(updatePromoTimer, 0));
        promoCarousel.addEventListener('keydown', event => {
            if (event.key === 'ArrowLeft') {
                event.preventDefault();
                showPromo(activePromo - 1);
                updatePromoTimer();
            } else if (event.key === 'ArrowRight') {
                event.preventDefault();
                showPromo(activePromo + 1);
                updatePromoTimer();
            }
        });
        document.addEventListener('visibilitychange', updatePromoTimer);
        updatePromoTimer();
    }

    function goToDetails(productId, event) {
        if (event?.target?.closest('.product-actions, button, form, a, input, select, textarea')) {
            return;
        }

        window.location.href = "/Products/Details/" + productId;
    }

    function addToCart(productId, event) {
        event?.preventDefault();
        event?.stopPropagation();
        event?.stopImmediatePropagation();
        fetch(`/Cart/Add?productId=${productId}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.requireLogin) openLogin();
                else if (data.success) showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddedToCart"].Value)), "success");
                else showToast(data.message || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddToCartFailed"].Value)), "error");
            });
    }

    attachDeleteConfirmations();
</script>
