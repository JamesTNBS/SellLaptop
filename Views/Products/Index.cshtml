@model IEnumerable<Laptop.Models.Product>

@functions {
    public string ResolveProductImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            return Url.Content("~/images/no-image.jpg");
        }

        if (imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) || imagePath.StartsWith("/"))
        {
            return imagePath;
        }

        return Url.Content("~/" + imagePath.TrimStart('/'));
    }
}

@{
    ViewData["Title"] = L["Shop"];

    var searchTerm = Context.Request.Query["search"].ToString().ToLower().Trim();
    var minPrice = decimal.TryParse(Context.Request.Query["minPrice"], out var minP) ? minP : 0;
    var priceLimit = Formatter.DisplayPriceLimit;
    var maxPrice = decimal.TryParse(Context.Request.Query["maxPrice"], out var maxP) ? maxP : priceLimit;
    var selectedConditions = Context.Request.Query["condition"].ToList();
    var selectedBrands = Context.Request.Query["brand"].ToList();
    var sortBy = Context.Request.Query["sort"].ToString().ToLower();
    var filtersOpen = selectedConditions.Any()
        || selectedBrands.Any()
        || Context.Request.Query.ContainsKey("minPrice")
        || Context.Request.Query.ContainsKey("maxPrice");

    var finalProducts = Model.ToList();
}

<div class="shop-container">
    <main class="main-content shop-main">

        <div class="shop-top-bar">
            <div class="results-count">@L["ProductsFound", finalProducts.Count()]</div>

            <div class="sort-section">
                <label>@L["SortBy"]</label>
                <select id="sort-select" onchange="applyFilters()">
                    <option value="">@L["Featured"]</option>
                    <option value="price-low" selected="@(sortBy == "price-low")">@L["PriceLowToHigh"]</option>
                    <option value="price-high" selected="@(sortBy == "price-high")">@L["PriceHighToLow"]</option>
                    <option value="newest" selected="@(sortBy == "newest")">@L["NewestArrivals"]</option>
                </select>
            </div>
        </div>

        <div class="shop-layout">
            <button type="button"
                    class="mobile-filter-toggle"
                    aria-controls="shop-filters"
                    aria-expanded="@(filtersOpen ? "true" : "false")"
                    onclick="toggleMobileFilters(this)">
                <i class="fas fa-sliders-h"></i>
                <span>@(filtersOpen ? L["HideFilters"] : L["ShowFilters"])</span>
            </button>

            <aside class="shop-filters @(filtersOpen ? "mobile-open" : "")" id="shop-filters">
                <h3>@L["PriceRange"]</h3>
                <div class="price-range">
                    <input type="range" id="price-slider" min="0" max="@priceLimit" step="@(Formatter.DisplayCurrency == "VND" ? "100000" : "100")"
                           value="@(maxPrice > 0 ? maxPrice : priceLimit)"
                           oninput="updatePriceDisplay(this.value)">
                    <div class="price-display" id="price-display">@Formatter.FormatDisplay(0) - @Formatter.FormatDisplay(maxPrice)</div>
                </div>

                <h3>@L["Condition"]</h3>
                @foreach (var cond in new[] { "New", "Like New", "Used - Excellent", "Used - Good", "Used - Fair" })
                {
                    bool isChecked = selectedConditions.Contains(cond);
                    <label>
                        <input type="checkbox" name="condition" value="@cond"
                               @(isChecked ? "checked" : "")> @Formatter.TranslateCondition(cond)
                    </label>
                }

                <h3>@L["Brands"]</h3>
                @foreach (var brand in new[] { "ASUS", "Acer", "Lenovo", "Dell", "HP", "Apple", "Samsung", "Microsoft", "MSI", "Razer" })
                {
                    bool isChecked = selectedBrands.Contains(brand);
                    <label>
                        <input type="checkbox" name="brand" value="@brand"
                               @(isChecked ? "checked" : "")> @brand
                    </label>
                }

                <button class="apply-btn" onclick="applyFilters()">@L["ApplyFilters"]</button>
                <button class="apply-btn" style="background:#666; margin-top:8px;" onclick="resetFilters()">@L["ResetFilters"]</button>
            </aside>

            <div class="shop-products">
                <div id="products-grid" class="shop-grid">
                    @if (!finalProducts.Any())
                    {
                        <div id="no-products">
                            <i class="fas fa-laptop" style="font-size:60px; opacity:0.4;"></i>
                            <h3>@L["NoProductsMatch"]</h3>
                        </div>
                    }
                    else
                    {
                        foreach (var product in finalProducts)
                        {
                            <div class="product-card" onclick="goToDetails(@product.Id, event)" style="cursor: pointer;">
                                <div class="product-image-container">
                                    @{
                                        var firstImage = product.Images?
                                            .Split(',')
                                            .Select(x => x.Trim())
                                            .FirstOrDefault(x => !string.IsNullOrEmpty(x));
                                    }

                                    <img src="@ResolveProductImage(firstImage)" alt="@product.Title" />
                                </div>

                                <div class="product-info">
                                    <h3>@product.Title</h3>
                                    <div class="model">@product.Model</div>
                                    <div class="price">@Formatter.Format(product)</div>
                                    <div class="condition">@Formatter.TranslateCondition(product.Condition)</div>
                                    <div class="seller">@L["Seller"]: @product.Seller</div>

                                    <div class="product-actions">
                                        <button type="button"
                                                onclick="addToCart(@product.Id, event);"
                                                class="add-to-cart-btn">
                                            <i class="fas fa-cart-plus"></i> @L["AddToCart"]
                                        </button>

                                        @if (ViewBag.Role == "Admin")
                                        {
                                            <form asp-action="DeleteConfirmed" method="post" style="display:inline;"
                                                  onclick="event.stopPropagation();"
                                                  class="confirm-delete-product-form">
                                                <input type="hidden" name="id" value="@product.Id" />
                                                <button type="submit" class="delete-product-btn" onclick="event.stopPropagation();">
                                                    <i class="fas fa-trash"></i> @L["Delete"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </main>
</div>

<script>
    const priceFilterUi = {
        locale: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Formatter.DisplayCurrency == "VND" ? "vi-VN" : "en-US")),
        currencySuffix: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Formatter.DisplayCurrency == "VND" ? " ₫" : " $")),
        minimum: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Formatter.FormatDisplay(0)))
    };

    function updatePriceDisplay(value) {
        const formattedValue = new Intl.NumberFormat(priceFilterUi.locale, {
            maximumFractionDigits: 0
        }).format(Number(value));
        document.getElementById("price-display").textContent = `${priceFilterUi.minimum} - ${formattedValue}${priceFilterUi.currencySuffix}`;
    }

    function applyFilters() {
        let url = "/Products/Index?";

        if ("@searchTerm" !== "") {
            url += `search=@searchTerm&`;
        }

        const maxPrice = document.getElementById("price-slider").value || @priceLimit;
        url += `minPrice=0&maxPrice=${maxPrice}&`;

        document.querySelectorAll('input[name="condition"]:checked').forEach(cb => {
            url += `condition=${encodeURIComponent(cb.value)}&`;
        });

        document.querySelectorAll('input[name="brand"]:checked').forEach(cb => {
            url += `brand=${encodeURIComponent(cb.value)}&`;
        });

        const sort = document.getElementById("sort-select").value;
        if (sort) {
            url += `sort=${sort}`;
        }

        url = url.replace(/&$/, "");

        window.location.href = url;
    }

    function resetFilters() {
        window.location.href = "/Products/Index";
    }

    function toggleMobileFilters(button) {
        const filters = document.getElementById('shop-filters');
        const isOpen = filters.classList.toggle('mobile-open');
        button.setAttribute('aria-expanded', String(isOpen));
        button.querySelector('span').textContent = isOpen ? @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["HideFilters"].Value)) : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["ShowFilters"].Value));
    }

    function goToDetails(productId, event) {
        if (event?.target?.closest('.product-actions, button, form, a, input, select, textarea')) {
            return;
        }

        window.location.href = "/Products/Details/" + productId;
    }

    function addToCart(productId, event) {
        event?.preventDefault();
        event?.stopPropagation();
        event?.stopImmediatePropagation();
        fetch(`/Cart/Add?productId=${productId}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
                if (data.requireLogin) openLogin();
                else if (data.success) showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddedToCart"].Value)), "success");
                else showToast(data.message || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddToCartFailed"].Value)), "error");
            });
    }

    document.querySelectorAll('.confirm-delete-product-form').forEach(form => {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            const confirmed = await showConfirm(
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteProductConfirmation"].Value)),
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteProduct"].Value))
            );
            if (confirmed) {
                form.submit();
            }
        });
    });
</script>
