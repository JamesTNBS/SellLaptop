@model Laptop.Models.Product

<div class="container">
    <div class="review-page-content product-create-page">
        <h1>@L["AddNewLaptop"]</h1>
        <div class="separate-main"></div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="review-form" onsubmit="syncImagesField()">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label>@L["Title"] <span style="color:red;">*</span></label>
                <input asp-for="Title" class="form-control" placeholder="@L["TitlePlaceholder"]" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>@L["Model"] <span style="color:red;">*</span></label>
                <input asp-for="Model" class="form-control" placeholder="@L["BrandPlaceholder"]" required />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>@L["Price"] <span style="color:red;">*</span></label>
                <input asp-for="Price" type="number" class="form-control" min="1" step="0.01" required />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>@L["Currency"] <span style="color:red;">*</span></label>
                <select asp-for="Currency" class="form-control">
                    <option value="USD">USD ($)</option>
                    <option value="VND">VND (₫)</option>
                </select>
            </div>

            <div class="section-input">
                <label>@L["Specifications"] <span style="color:red;">*</span></label>
                <textarea asp-for="Specifications" class="form-control"
                          placeholder="@L["SpecificationsPlaceholder"]"
                          rows="6"></textarea>
                <span asp-validation-for="Specifications" class="text-danger"></span>
            </div>

            <div class="section-input">
                <label>@L["TechnicalSpecifications"] <span style="color:red;">*</span></label>
                <textarea asp-for="TechnicalSpecifications" class="form-control"
                          placeholder="@L["TechnicalSpecificationsPlaceholder"]"
                          rows="18"></textarea>
            </div>

            <div class="section-input">
                <label>@L["Short Description"] <span style="color:red;">*</span></label>
                <textarea asp-for="Description" class="form-control"
                          placeholder="@L["ShortDescriptionPlaceholder"]"
                          rows="6" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="edit-group image-editor-group">
                <label>@L["Images"] <span style="color:red;">*</span></label>
                <input asp-for="Images" type="hidden" />
                <span asp-validation-for="Images" class="text-danger"></span>

                <div class="image-manager product-image-manager">
                    <div class="image-manager-add">
                        <input type="text" id="image-url-input" class="form-control"
                               placeholder="@L["PasteImageUrlPlaceholder"]" />
                        <button type="button" class="post-btn" onclick="addImageUrl()">@L["AddUrl"]</button>
                    </div>

                    <div class="image-manager-upload">
                        <label for="image-files">@L["UploadImagesFromComputer"]</label>
                        <input type="file" id="image-files" name="imageFiles" class="form-control" accept="image/*" multiple onchange="handleFileSelection()" />
                    </div>

                    <div id="image-manager-list" class="image-manager-list product-image-manager-list"></div>
                </div>
            </div>

            <div class="gallery-preview" id="gallery-preview" style="display:none;">
                <div id="preview-thumbnails" class="thumb-column"></div>
                <div class="main-image-container">
                    <img id="preview-main" class="main-img" alt="@L["Preview"]">
                </div>
            </div>

            <div class="section-input">
                <label>@L["FullDescription"] <span style="color:red;">*</span></label>
                <textarea asp-for="FullDescription" class="form-control" rows="10"></textarea>
            </div>

            <div class="form-group">
                <label>@L["Condition"]</label>
                <select asp-for="Condition" class="form-control">
                    <option value="New">@Formatter.TranslateCondition("New")</option>
                    <option value="Like New" selected>@Formatter.TranslateCondition("Like New")</option>
                    <option value="Used - Excellent">@Formatter.TranslateCondition("Used - Excellent")</option>
                    <option value="Used - Good">@Formatter.TranslateCondition("Used - Good")</option>
                    <option value="Used - Fair">@Formatter.TranslateCondition("Used - Fair")</option>
                </select>
            </div>

            <button type="submit" class="publish-btn">
                <i class="fas fa-plus"></i> @L["AddToShop"]
            </button>
        </form>
    </div>
</div>

<script>
    const imageState = {
        existing: [],
        newFiles: []
    };

    function normalizePreviewUrl(path) {
        if (!path) return "";
        if (path.startsWith("blob:") || path.startsWith("http://") || path.startsWith("https://") || path.startsWith("/")) {
            return path;
        }
        return "/" + path.replace(/^\/+/, "");
    }

    function syncImagesField() {
        document.querySelector('[name="Images"]').value = imageState.existing.join(', ');
    }

    function syncFileInput() {
        const input = document.getElementById('image-files');
        const dataTransfer = new DataTransfer();
        imageState.newFiles.forEach(entry => dataTransfer.items.add(entry.file));
        input.files = dataTransfer.files;
    }

        function addImageUrl() {
            const input = document.getElementById('image-url-input');
            const values = input.value
                .split(/[\r\n,]+/)
                .map(x => x.trim())
                .filter(x => x.length > 0);

            if (!values.length) return;

            values.forEach(value => imageState.existing.push(value));
            input.value = "";
            renderImageManager();
        }

    function handleFileSelection() {
        const files = Array.from(document.getElementById('image-files').files);
        files.forEach(file => {
            imageState.newFiles.push({
                id: crypto.randomUUID(),
                file,
                previewUrl: URL.createObjectURL(file)
            });
        });
        syncFileInput();
        renderImageManager();
    }

    function removeExistingImage(index) {
        imageState.existing.splice(index, 1);
        renderImageManager();
    }

    function removeNewFile(id) {
        const removed = imageState.newFiles.find(x => x.id === id);
        if (removed) {
            URL.revokeObjectURL(removed.previewUrl);
        }
        imageState.newFiles = imageState.newFiles.filter(x => x.id !== id);
        syncFileInput();
        renderImageManager();
    }

    function renderImageManager() {
        syncImagesField();

        const manager = document.getElementById('image-manager-list');
        const thumb = document.getElementById('preview-thumbnails');
        const main = document.getElementById('preview-main');
        const galleryPreview = document.getElementById('gallery-preview');

        manager.innerHTML = "";
        thumb.innerHTML = "";
        let firstPreview = null;

        imageState.existing.forEach((path, index) => {
            const resolvedUrl = normalizePreviewUrl(path);
            appendManagerCard({
                label: path.startsWith('http') ? @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["UrlImage"].Value)) : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SavedImage"].Value)),
                previewUrl: resolvedUrl,
                onRemove: `removeExistingImage(${index})`
            });
            appendPreview(resolvedUrl);
        });

        imageState.newFiles.forEach(entry => {
            appendManagerCard({
                label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["NewUpload"].Value)),
                previewUrl: entry.previewUrl,
                onRemove: `removeNewFile('${entry.id}')`
            });
            appendPreview(entry.previewUrl);
        });

        if (!firstPreview) {
            main.removeAttribute('src');
            galleryPreview.style.display = 'none';
        } else {
            galleryPreview.style.display = 'flex';
        }

        function appendManagerCard(item) {
            manager.insertAdjacentHTML('beforeend', `
                <div class="image-manager-card">
                    <img src="${item.previewUrl}" alt="${item.label}">
                    <div class="image-manager-meta">${item.label}</div>
                    <button type="button" class="btn-cancel image-remove-btn" onclick="${item.onRemove}">@L["Remove"]</button>
                </div>
            `);
        }

        function appendPreview(src) {
            const img = document.createElement("img");
            img.src = src;
            img.style.width = "60px";
            img.style.cursor = "pointer";
            img.onclick = () => main.src = src;
            thumb.appendChild(img);

            if (!firstPreview) {
                firstPreview = src;
                main.src = src;
            }
        }
    }

    window.addEventListener('beforeunload', () => {
        imageState.newFiles.forEach(entry => URL.revokeObjectURL(entry.previewUrl));
    });
</script>
