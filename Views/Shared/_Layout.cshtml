@using Laptop.Extensions
@using Laptop.Models

@{
    var user = Context.Session.GetString("User");
    var role = Context.Session.GetString("Role");
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}


<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Laptop</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/images/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/Laptop.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>

    @Html.AntiForgeryToken()

        <!-- Sidebar + Page -->
    <div class="shop-container">


        <div class="side-panel" id="sidePanel">
            <p id="#user-display" style=" text-align:center">
                <i class="fas fa-user"></i>
                <span id="username-text">@(user ?? L["Guest"].Value)</span>
            </p>

            <div class="separate1"></div>

            <!-- NAV -->
            <div class="nav-links">
                <a asp-controller="Products" asp-action="Index">
                    <span>🏠</span> @L["Home"]
                </a>

                <a href="#" onclick="goToCart(); return false;" class="cart-link">
                    🛒 @L["Cart"] <span class="cart-badge">@ViewBag.CartCount</span>
                </a>

                @if (!string.IsNullOrEmpty(user))
                {
                    <a asp-controller="Cart" asp-action="MyOrders">
                        <i class="fas fa-receipt"></i> @L["MyOrders"]
                    </a>
                }

                <a href="#" onclick="openSearchPopup(); return false;">
                    <span>🔍</span> @L["Search"]
                </a>

                <a href="https://zalo.me/0792351781" target="_blank" rel="noopener noreferrer">
                    <i class="fas fa-comments"></i> Zalo
                </a>

                @if (role == "Admin")
                {

                    <!-- Add Laptop -->
                    <a asp-controller="Products" asp-action="Create">
                        <i class="fas fa-plus-circle"></i> @L["AddLaptop"]
                    </a>

                    <!-- Admin Dashboard Button -->
                    <a asp-controller="Admin" asp-action="Index">
                        <i class="fas fa-tachometer-alt"></i> @L["Dashboard"]
                    </a>
                }
            </div>

            <div class="separate2"></div>

            <!-- Dark Mode -->
                <form asp-controller="Language" asp-action="Set" method="post" style="margin:0 0 15px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <select id="language-selector" name="culture" aria-label="@L["ChooseLanguage"]" onchange="this.form.submit()" style="width:100%; padding:8px; border-radius:6px;">
                        <option value="en-US" selected="@(currentCulture == "en-US")">@L["English"]</option>
                        <option value="vi-VN" selected="@(currentCulture == "vi-VN")">@L["Vietnamese"]</option>
                    </select>
                </form>

                <button style="width: 100%;" class="toggle-light-mode" title="@L["DarkMode"]">
                <i class="fas fa-sun"></i>
            </button>

            <!-- AUTH BUTTONS -->
            @if (string.IsNullOrEmpty(user))
            {
                <button class="auth-btn login-btn" onclick="openLogin()">@L["Login"]</button>
                <button class="auth-btn register-btn" onclick="openRegister()">@L["Register"]</button>
            }
            else
            {
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">
                    <input type="hidden" name="returnUrl"
                           value="@Context.Request.Path@Context.Request.QueryString" />
                    <button class="auth-btn logout-btn">@L["Logout"]</button>
                </form>
            }


            <div class="separate3"></div>
        </div>

        <!-- Hamburger Menu -->
        <button class="menu-toggle" onclick="toggleSidePanel()">
            <i class="fas fa-bars"></i>
        </button>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- ==================== POPUPS (Outside sidebar!) ==================== -->
    <!-- Login Popup -->
    <div id="login-modal" class="popup-overlay">
        <div class="popup-box">
            <span class="popup-close" onclick="closeLogin()">×</span>
            <h4>@L["Login"]</h4>

            <!-- Login Popup Form -->
            <form id="login-form" onsubmit="submitLogin(event)">
                <input type="text"
                       id="login-username"
                       placeholder="@L["Username"]"
                       required
                       oninvalid="this.setCustomValidity('@L["UsernameRequired"]')"
                       oninput="this.setCustomValidity('')" />
                <div class="password-field">
                    <input type="password"
                           id="login-password"
                           placeholder="@L["Password"]"
                           required
                           oninvalid="this.setCustomValidity('@L["PasswordRequired"]')"
                           oninput="this.setCustomValidity('')" />
                    <span onclick="togglePassword('login-password')">👁</span>
                </div>
                <button type="submit">@L["Login"]</button>
            </form>

            <p class="popup-switch">
                <a href="#" onclick="switchToForgotPassword(); return false;">@L["ForgotPassword"]</a>
            </p>

            <p class="popup-switch">
                @L["NoAccount"]
                <a href="#" onclick="switchToRegister(); return false;">@L["RegisterHere"]</a>
            </p>
        </div>
    </div>

    <div id="forgot-password-modal" class="popup-overlay">
        <div class="popup-box">
            <span class="popup-close" onclick="closeForgotPassword()">×</span>
            <h4>@L["ResetPassword"]</h4>
            <form id="forgot-password-form" onsubmit="submitForgotPassword(event)">
                <input type="text"
                       id="forgot-lookup"
                       placeholder="@L["UsernameOrEmail"]"
                       required
                       oninvalid="this.setCustomValidity('@L["UsernameOrEmailRequired"]')"
                       oninput="this.setCustomValidity('')" />
                <div class="password-field">
                    <input type="password"
                           id="forgot-new-password"
                           placeholder="@L["NewPassword"]"
                           required
                           minlength="6"
                           oninvalid="this.setCustomValidity('@L["NewPasswordRequired"]')"
                           oninput="this.setCustomValidity('')" />
                    <span onclick="togglePassword('forgot-new-password')">👁</span>
                </div>
                <button type="submit">@L["ResetPassword"]</button>
            </form>

            <p class="popup-switch">
                @L["RememberedPassword"]
                <a href="#" onclick="switchForgotToLogin(); return false;">@L["LoginHere"]</a>
            </p>
        </div>
    </div>

    <div id="register-modal" class="popup-overlay">
        <div class="popup-box">
            <span class="popup-close" onclick="closeRegister()">×</span>
            <h4>@L["CreateAccount"]</h4>
            <form id="register-form" onsubmit="submitRegister(event)">
                @Html.AntiForgeryToken()

                <input type="hidden" name="returnUrl"
                       value="@Context.Request.Path@Context.Request.QueryString" />

                <!-- Username -->
                <input type="text"
                       name="username"
                       placeholder="@L["Username"]"
                       required
                       oninvalid="this.setCustomValidity('@L["UsernameRequired"]')"
                       oninput="this.setCustomValidity('')" />

                <!-- Email -->
                <input type="email"
                       name="email"
                       placeholder="@L["EmailAddress"]"
                       required
                       oninvalid="this.setCustomValidity('@L["ValidEmailRequired"]')"
                       oninput="this.setCustomValidity('')" />

                <!-- Password -->
                <div class="password-field">
                    <input type="password"
                           id="register-pass"
                           name="password"
                           placeholder="@L["EnterPassword"]"
                           required
                           oninvalid="this.setCustomValidity('@L["PasswordRequired"]')"
                           oninput="this.setCustomValidity('')" />
                    <span onclick="togglePassword('register-pass')">👁</span>
                </div>

                <button type="submit">@L["Register"]</button>
            </form>

            <p class="popup-switch">
                @L["AlreadyHaveAccount"]
                <a href="#" onclick="switchToLogin(); return false;">@L["LoginHere"]</a>
            </p>
        </div>
    </div>

    <!-- Search Popup -->
    <div id="search-modal" class="popup-overlay search-popup">
        <div class="popup-box search-popup-box">
            <span class="close-search" onclick="closeSearchPopup()">×</span>
            <h4>@L["SearchLaptops"]</h4>
            <input type="text" id="search-input" placeholder="@L["EnterSearch"]">
            <button type="button" onclick="performSearch()">@L["Search"]</button>
        </div>
    </div>

    <div id="confirm-modal" class="popup-overlay confirm-overlay">
        <div class="popup-box confirm-box">
            <span class="popup-close" onclick="closeConfirm(false)">×</span>
            <h4 id="confirm-title">@L["PleaseConfirm"]</h4>
            <p id="confirm-message" class="confirm-message"></p>
            <div class="confirm-actions">
                <button type="button" class="confirm-cancel-btn" onclick="closeConfirm(false)">@L["No"]</button>
                <button type="button" class="confirm-confirm-btn" onclick="closeConfirm(true)">@L["Yes"]</button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/script.js"></script>

    <script>
            function openLogin() {
                document.getElementById("login-modal").style.display = "flex";
            }
            function closeLogin() {
                document.getElementById("login-modal").style.display = "none";
            }

            function openRegister() {
                document.getElementById("register-modal").style.display = "flex";
            }
            function closeRegister() {
                document.getElementById("register-modal").style.display = "none";
            }

            function openForgotPassword() {
                document.getElementById("forgot-password-modal").style.display = "flex";
            }

            function closeForgotPassword() {
                document.getElementById("forgot-password-modal").style.display = "none";
            }

            function openSearchPopup() {
                document.getElementById("search-modal").style.display = "flex";
            }

            function closeSearchPopup() {
                document.getElementById("search-modal").style.display = "none";
            }

            let confirmResolver = null;

            const localizedUi = {
                addedToCart: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddedToCart"].Value)),
                addToCartFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddToCartFailed"].Value)),
                loginFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["LoginFailed"].Value)),
                loginError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["LoginError"].Value)),
                passwordReset: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PasswordReset"].Value)),
                passwordResetFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PasswordResetFailed"].Value)),
                passwordResetError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PasswordResetError"].Value)),
                registrationError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["RegistrationError"].Value)),
                pleaseConfirm: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PleaseConfirm"].Value))
            };

            function showConfirm(message, title = localizedUi.pleaseConfirm) {
                const modal = document.getElementById("confirm-modal");
                const titleElement = document.getElementById("confirm-title");
                const messageElement = document.getElementById("confirm-message");

                if (!modal || !titleElement || !messageElement) {
                    return Promise.resolve(window.confirm(message));
                }

                titleElement.textContent = title;
                messageElement.innerHTML = String(message).replace(/\n/g, "<br>");
                modal.style.display = "flex";

                return new Promise(resolve => {
                    confirmResolver = resolve;
                });
            }

            function closeConfirm(result) {
                const modal = document.getElementById("confirm-modal");
                if (modal) {
                    modal.style.display = "none";
                }

                if (confirmResolver) {
                    const resolver = confirmResolver;
                    confirmResolver = null;
                    resolver(Boolean(result));
                }
            }

            window.showConfirm = showConfirm;
            window.closeConfirm = closeConfirm;

             function performSearch() {
                const query = document.getElementById("search-input").value.toLowerCase().trim();
                if (!query) {
                    closeSearchPopup();
                    return;
                }

                window.location.href = `/Products/Index?search=${encodeURIComponent(query)}`;
            }

            function addToCart(productId) {
                fetch(`/Cart/Add?productId=${productId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(res => res.json())
                .then(data => {
                    if (data.requireLogin) {
                        openLogin();
                    } else if (data.success) {
                        document.querySelector(".cart-badge").textContent = data.cartCount;
                        showToast(localizedUi.addedToCart, "success");
                    } else {
                        showToast(data.message || localizedUi.addToCartFailed, "error");
                    }
                });
            }


            function goToCart() {
                const isLoggedIn = "@(user ?? "")" !== "";

                if (!isLoggedIn) {
                    openLogin();
                } else {
                    window.location.href = "/Cart";
                }
            }

            function switchToRegister() {
                closeLogin();
                closeForgotPassword();
                setTimeout(() => {
                    openRegister();
                }, 200);
            }

            function switchToLogin() {
                closeRegister();
                closeForgotPassword();
                setTimeout(() => {
                    openLogin();
                }, 200);
            }

            function switchToForgotPassword() {
                closeLogin();
                setTimeout(() => {
                    openForgotPassword();
                }, 200);
            }

            function switchForgotToLogin() {
                closeForgotPassword();
                setTimeout(() => {
                    openLogin();
                }, 200);
            }

            function togglePassword(id) {
                const input = document.getElementById(id);
                input.type = input.type === "password" ? "text" : "password";
            }

            function submitLogin(event) {
                event.preventDefault();

                const username = document.getElementById("login-username").value.trim();
                const password = document.getElementById("login-password").value;

                fetch('/Account/Login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: `username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        closeLogin();
                        location.reload();
                    } else {
                        showToast(data.message || localizedUi.loginFailed, "error");
                    }
                })
                .catch(err => {
                    console.error(err);
                    showToast(localizedUi.loginError, "error");
                });
            }


            function submitForgotPassword(event) {
                event.preventDefault();

                const usernameOrEmail = document.getElementById("forgot-lookup").value.trim();
                const newPassword = document.getElementById("forgot-new-password").value;

                fetch('/Account/ForgotPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: `usernameOrEmail=${encodeURIComponent(usernameOrEmail)}&newPassword=${encodeURIComponent(newPassword)}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message || localizedUi.passwordReset, "success");
                        document.getElementById("forgot-password-form").reset();
                        switchForgotToLogin();
                    } else {
                        showToast(data.message || localizedUi.passwordResetFailed, "error");
                    }
                })
                .catch(err => {
                    console.error(err);
                    showToast(localizedUi.passwordResetError, "error");
                });
            }


                        function submitRegister(event) {
                event.preventDefault();

                const username = document.querySelector('input[name="username"]').value.trim();
                const email = document.querySelector('input[name="email"]').value.trim();
                const password = document.querySelector('input[name="password"]').value;

                fetch('/Account/Register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: `username=${encodeURIComponent(username)}&email=${encodeURIComponent(email)}&password=${encodeURIComponent(password)}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, "success");

                        closeRegister();
                        setTimeout(() => openLogin(), 500);

                        document.getElementById("register-form").reset();
                    } else {
                        showToast(data.message, "error");
                    }
                })
                .catch(err => {
                    console.error(err);
                    showToast(localizedUi.registrationError, "error");
                });
            }


            document.getElementById("search-input").addEventListener("keydown", function(e) {
                if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                }
            });

            document.addEventListener("keydown", function(e) {
                if (e.key === "Escape" && document.getElementById("confirm-modal")?.style.display === "flex") {
                    closeConfirm(false);
                }
            });


                function showToast(message, type = "info", duration = 3000) {
                const container = document.getElementById("toast-container");

                const toast = document.createElement("div");
                toast.className = `toast ${type}`;
                toast.textContent = message;

                container.appendChild(toast);

                setTimeout(() => toast.classList.add("show"), 100);

                setTimeout(() => {
                    toast.classList.remove("show");
                    setTimeout(() => container.removeChild(toast), 300);
                }, duration);
            }

    </script>

    <div id="toast-container"></div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
