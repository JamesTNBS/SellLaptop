@model ErrorViewModel
@{
    ViewData["Title"] = L["Error"];
}

<h1 class="text-danger">@L["Error"].</h1>
<h2 class="text-danger">@L["ErrorProcessingRequest"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["RequestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L["DevelopmentMode"]</h3>
<p>
    @Html.Raw(L["DevelopmentModeSwapInfo"].Value)
</p>
<p>
    @Html.Raw(L["DevelopmentModeWarning"].Value)
</p>
