@using Laptop.Models

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending Payment" => "status-pending-payment",
            "Paid" => "status-paid",
            "Delivered" => "status-delivered",
            "Cancelled" => "status-cancelled",
            _ => "status-pending"
        };
    }
}

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var recentOrders = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
    var recentComments = ViewBag.RecentComments as List<Comment> ?? new List<Comment>();
    var newestProducts = ViewBag.NewestProducts as List<Product> ?? new List<Product>();
    var orderStatusCounts = ViewBag.OrderStatusCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var revenueByDay = ViewBag.RevenueByDay as List<KeyValuePair<string, decimal>> ?? new List<KeyValuePair<string, decimal>>();
    var topProducts = ViewBag.TopProducts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var statusOrder = new[] { "Pending", "Pending Payment", "Paid", "Delivered", "Cancelled" };
    var maxStatusCount = Math.Max(1, statusOrder.Max(status => orderStatusCounts.TryGetValue(status, out var count) ? count : 0));
    var maxRevenue = Math.Max(1m, revenueByDay.Any() ? revenueByDay.Max(day => day.Value) : 0m);
    var maxProductQuantity = Math.Max(1, topProducts.Any() ? topProducts.Max(product => product.Value) : 0);
}

<style>
    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 22px;
    }

    .dashboard-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    }

    .dashboard-label {
        color: #666;
        font-size: 13px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .dashboard-value {
        font-size: 30px;
        font-weight: 700;
        color: #222;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
    }

    .dashboard-list {
        display: grid;
        gap: 12px;
    }

    .dashboard-item {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 12px 0;
        border-top: 1px solid #ececec;
    }

    .dashboard-item:first-child {
        border-top: none;
        padding-top: 0;
    }

    .dashboard-title {
        font-weight: 700;
        color: #222;
        margin-bottom: 4px;
    }

    .dashboard-meta {
        color: #666;
        font-size: 14px;
    }

    .dashboard-link {
        color: #7348d9;
        text-decoration: none;
        font-weight: 600;
    }

    .dashboard-charts {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
        margin-bottom: 22px;
    }

    .chart-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 18px;
    }

    .chart-card h2 {
        margin: 0 0 14px;
    }

    .status-chart,
    .top-products-chart {
        display: grid;
        gap: 12px;
    }

    .chart-row {
        display: grid;
        grid-template-columns: 130px minmax(0, 1fr) 38px;
        gap: 10px;
        align-items: center;
    }

    .chart-row-label {
        color: #333;
        font-size: 14px;
        font-weight: 700;
    }

    .chart-track {
        height: 12px;
        overflow: hidden;
        border-radius: 999px;
        background: #eee9fb;
    }

    .chart-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #7348d9, #a786ff);
    }

    .chart-number {
        color: #555;
        font-size: 13px;
        font-weight: 700;
        text-align: right;
    }

    .revenue-chart {
        display: flex;
        gap: 12px;
        align-items: end;
        min-height: 190px;
        padding-top: 12px;
    }

    .revenue-bar-wrap {
        flex: 1;
        display: grid;
        gap: 8px;
        align-items: end;
        text-align: center;
    }

    .revenue-bar {
        width: 100%;
        min-height: 8px;
        border-radius: 10px 10px 4px 4px;
        background: linear-gradient(180deg, #7348d9, #b59fff);
    }

    .revenue-label {
        color: #666;
        font-size: 12px;
    }

    .revenue-value {
        color: #333;
        font-size: 12px;
        font-weight: 700;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 4px 9px;
        font-size: 12px;
        font-weight: 700;
        width: fit-content;
    }

    .status-pending {
        background: #fff2d8;
        color: #9b6400;
    }

    .status-pending-payment {
        background: #efe7ff;
        color: #5f3ab0;
    }

    .status-paid {
        background: #dbf5e5;
        color: #1f7a42;
    }

    .status-delivered {
        background: #dfe9ff;
        color: #345bb8;
    }

    .status-cancelled {
        background: #ffe1e1;
        color: #b42323;
    }

    @@media (max-width: 640px) {
        .chart-row {
            grid-template-columns: 1fr;
            gap: 6px;
        }

        .chart-number {
            text-align: left;
        }
    }
</style>

<h1>Dashboard Overview</h1>

<div class="dashboard-stats">
    <div class="dashboard-card">
        <div class="dashboard-label">Total Users</div>
        <div class="dashboard-value">@ViewBag.TotalUsers</div>
    </div>
    <div class="dashboard-card">
        <div class="dashboard-label">Total Products</div>
        <div class="dashboard-value">@ViewBag.TotalProducts</div>
    </div>
    <div class="dashboard-card">
        <div class="dashboard-label">Total Orders</div>
        <div class="dashboard-value">@ViewBag.TotalOrders</div>
    </div>
    <div class="dashboard-card">
        <div class="dashboard-label">Total Revenue</div>
        <div class="dashboard-value">$@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</div>
    </div>
</div>

<div class="dashboard-charts">
    <section class="chart-card">
        <h2>Orders by Status</h2>
        <div class="status-chart">
            @foreach (var status in statusOrder)
            {
                var count = orderStatusCounts.TryGetValue(status, out var value) ? value : 0;
                var width = Math.Round((count / (double)maxStatusCount) * 100);

                <div class="chart-row">
                    <span class="status-badge @GetStatusBadgeClass(status)">@status</span>
                    <div class="chart-track">
                        <div class="chart-fill" style="width:@width%;"></div>
                    </div>
                    <span class="chart-number">@count</span>
                </div>
            }
        </div>
    </section>

    <section class="chart-card">
        <h2>Revenue Last 7 Days</h2>
        <div class="revenue-chart">
            @foreach (var day in revenueByDay)
            {
                var height = Math.Max(8, Math.Round((day.Value / maxRevenue) * 150));

                <div class="revenue-bar-wrap">
                    <div class="revenue-value">$@day.Value.ToString("N0")</div>
                    <div class="revenue-bar" style="height:@(height)px;"></div>
                    <div class="revenue-label">@day.Key</div>
                </div>
            }
        </div>
    </section>

    <section class="chart-card">
        <h2>Top Selling Products</h2>
        @if (!topProducts.Any())
        {
            <p class="admin-muted">No sold products yet.</p>
        }
        else
        {
            <div class="top-products-chart">
                @foreach (var product in topProducts)
                {
                    var width = Math.Round((product.Value / (double)maxProductQuantity) * 100);

                    <div class="chart-row">
                        <span class="chart-row-label">@product.Key</span>
                        <div class="chart-track">
                            <div class="chart-fill" style="width:@width%;"></div>
                        </div>
                        <span class="chart-number">@product.Value</span>
                    </div>
                }
            </div>
        }
    </section>
</div>

<div class="dashboard-grid">
    <section class="admin-section">
        <div class="admin-toolbar">
            <h2 style="margin:0;">Recent Orders</h2>
            <a asp-action="Orders" class="dashboard-link">View all</a>
        </div>

        @if (!recentOrders.Any())
        {
            <p class="admin-muted">No orders yet.</p>
        }
        else
        {
            <div class="dashboard-list">
                @foreach (var order in recentOrders)
                {
                    <div class="dashboard-item">
                        <div>
                            <div class="dashboard-title">Order #@order.Id</div>
                            <div class="dashboard-meta">@(order.User?.Username ?? order.Username) • @order.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</div>
                        </div>
                        <div class="dashboard-title">$@order.TotalAmount.ToString("N2")</div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="admin-section">
        <div class="admin-toolbar">
            <h2 style="margin:0;">Recent Comments</h2>
            <a asp-action="Comments" class="dashboard-link">View all</a>
        </div>

        @if (!recentComments.Any())
        {
            <p class="admin-muted">No comments yet.</p>
        }
        else
        {
            <div class="dashboard-list">
                @foreach (var comment in recentComments)
                {
                    <div class="dashboard-item">
                        <div>
                            <div class="dashboard-title">@comment.User.Username on @comment.Product.Title</div>
                            <div class="dashboard-meta">@comment.Text</div>
                        </div>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@comment.ProductId" class="dashboard-link">Open</a>
                    </div>
                }
            </div>
        }
    </section>

    <section class="admin-section">
        <div class="admin-toolbar">
            <h2 style="margin:0;">Newest Products</h2>
            <a asp-controller="Products" asp-action="Index" class="dashboard-link">Shop view</a>
        </div>

        @if (!newestProducts.Any())
        {
            <p class="admin-muted">No products yet.</p>
        }
        else
        {
            <div class="dashboard-list">
                @foreach (var product in newestProducts)
                {
                    <div class="dashboard-item">
                        <div>
                            <div class="dashboard-title">@product.Title</div>
                            <div class="dashboard-meta">@product.Model • @product.Condition</div>
                        </div>
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="dashboard-link">$@product.Price.ToString("N0")</a>
                    </div>
                }
            </div>
        }
    </section>
</div>
