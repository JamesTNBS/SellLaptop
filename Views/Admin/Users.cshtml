@model IEnumerable<Laptop.Models.User>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var search = ViewBag.Search as string ?? string.Empty;
    var roleFilter = ViewBag.RoleFilter as string ?? "All";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var commentCounts = ViewBag.UserCommentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var orderCounts = ViewBag.UserOrderCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var cartCounts = ViewBag.UserCartCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<h1>Manage Users</h1>

<div class="admin-toolbar">
    <form method="get" class="admin-filters">
        <input type="text" name="search" value="@search" placeholder="Search username or email" />
        <select name="role">
            <option value="All" selected="@(roleFilter == "All")">All roles</option>
            <option value="Admin" selected="@(roleFilter == "Admin")">Admin</option>
            <option value="User" selected="@(roleFilter == "User")">User</option>
        </select>
        <button type="submit">Apply</button>
    </form>

    <span class="admin-pill">@totalCount user(s)</span>
</div>

<div class="admin-section">
    <table>
        <thead>
            <tr>
                <th>User</th>
                <th>Role</th>
                <th>Activity Summary</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var userCartCount = cartCounts.TryGetValue(user.Username, out var cartCount) ? cartCount : 0;
                var userCommentCount = commentCounts.TryGetValue(user.Id, out var commentCount) ? commentCount : 0;
                var userOrderCount = orderCounts.TryGetValue(user.Id, out var orderCount) ? orderCount : 0;

                <tr id="user-@user.Id">
                    <td>
                        <div style="font-weight:700;">@user.Username</div>
                        <div class="admin-muted">@user.Email</div>
                    </td>
                    <td>
                        <span class="admin-pill">@user.Role</span>
                    </td>
                    <td>
                        <div class="admin-muted">Orders: @userOrderCount</div>
                        <div class="admin-muted">Comments: @userCommentCount</div>
                        <div class="admin-muted">Cart items: @userCartCount</div>
                    </td>
                    <td style="white-space: nowrap;">
                        @if (user.Role != "Admin")
                        {
                            <button id="role-btn-@user.Id" onclick="makeAdmin(@user.Id)">
                                Make Admin
                            </button>
                        }
                        else if (user.Username != "JamesTNBS")
                        {
                            <button id="role-btn-@user.Id" onclick="removeAdmin(@user.Id)">
                                Remove Admin
                            </button>
                        }

                        @if (user.Username != "JamesTNBS")
                        {
                            <button onclick="deleteUser(@user.Id, '@user.Username', @userOrderCount, @userCommentCount, @userCartCount)"
                                    class="admin-danger">
                                Delete
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="admin-muted" style="margin-top:16px;">No users match your filters.</p>
    }
 </div>

@if (totalPages > 1)
{
    <div class="admin-pagination">
        @if (currentPage > 1)
        {
            <a asp-action="Users" asp-route-search="@search" asp-route-role="@roleFilter" asp-route-page="@(currentPage - 1)">Previous</a>
        }

        <span class="current">Page @currentPage of @totalPages</span>

        @if (currentPage < totalPages)
        {
            <a asp-action="Users" asp-route-search="@search" asp-route-role="@roleFilter" asp-route-page="@(currentPage + 1)">Next</a>
        }
    </div>
}

@Html.AntiForgeryToken()

<script>
    function makeAdmin(id) {
        fetch('/Admin/MakeAdmin', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id })
        }).then(() => {
            showToast("User promoted to admin", "success");
            setTimeout(() => window.location.reload(), 450);
        });
    }

    function removeAdmin(id) {
        fetch('/Admin/RemoveAdmin', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id })
        }).then(() => {
            showToast("Admin role removed", "success");
            setTimeout(() => window.location.reload(), 450);
        });
    }

    async function deleteUser(id, username, orderCount, commentCount, cartCount) {
        const summary = [
            `Delete user "${username}"?`,
            '',
            `Orders: ${orderCount}`,
            `Comments: ${commentCount}`,
            `Cart items: ${cartCount}`,
            '',
            'This cannot be undone.'
        ].join('\n');

        const confirmed = await showConfirm(summary, "Delete User");
        if (!confirmed) return;

        fetch('/Admin/DeleteUser', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id })
        }).then(() => {
            const row = document.getElementById(`user-${id}`);
            if (row) {
                row.remove();
            }
            showToast(`Deleted ${username}`, "success");
        });
    }
</script>
