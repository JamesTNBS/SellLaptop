@model IEnumerable<Laptop.Models.User>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var search = ViewBag.Search as string ?? string.Empty;
    var roleFilter = ViewBag.RoleFilter as string ?? "All";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var commentCounts = ViewBag.UserCommentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var orderCounts = ViewBag.UserOrderCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var cartCounts = ViewBag.UserCartCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<h1>@L["ManageUsers"]</h1>

<div class="admin-toolbar">
    <form method="get" class="admin-filters">
        <input type="text" name="search" value="@search" placeholder="@L["SearchUsersPlaceholder"]" />
        <select name="role">
            <option value="All" selected="@(roleFilter == "All")">@L["AllRoles"]</option>
            <option value="Admin" selected="@(roleFilter == "Admin")">@Formatter.TranslateRole("Admin")</option>
            <option value="User" selected="@(roleFilter == "User")">@Formatter.TranslateRole("User")</option>
        </select>
        <button type="submit">@L["Apply"]</button>
    </form>

    <span class="admin-pill">@L["UserCountBadge", totalCount]</span>
</div>

<div class="admin-section">
    <table>
        <thead>
            <tr>
                <th>@L["User"]</th>
                <th>@L["Role"]</th>
                <th>@L["ActivitySummary"]</th>
                <th>@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                var userCartCount = cartCounts.TryGetValue(user.Username, out var cartCount) ? cartCount : 0;
                var userCommentCount = commentCounts.TryGetValue(user.Id, out var commentCount) ? commentCount : 0;
                var userOrderCount = orderCounts.TryGetValue(user.Id, out var orderCount) ? orderCount : 0;

                <tr id="user-@user.Id">
                    <td>
                        <div style="font-weight:700;">@user.Username</div>
                        <div class="admin-muted">@user.Email</div>
                    </td>
                    <td>
                        <span class="admin-pill">@Formatter.TranslateRole(user.Role)</span>
                    </td>
                    <td>
                        <div class="admin-muted">@L["OrdersCountLabel", userOrderCount]</div>
                        <div class="admin-muted">@L["CommentsCountLabel", userCommentCount]</div>
                        <div class="admin-muted">@L["CartItemsCountLabel", userCartCount]</div>
                    </td>
                    <td style="white-space: nowrap;">
                        @if (user.Role != "Admin")
                        {
                            <button id="role-btn-@user.Id" onclick="makeAdmin(@user.Id)">
                                @L["MakeAdmin"]
                            </button>
                        }
                        else if (user.Username != "JamesTNBS")
                        {
                            <button id="role-btn-@user.Id" onclick="removeAdmin(@user.Id)">
                                @L["RemoveAdmin"]
                            </button>
                        }

                        @if (user.Username != "JamesTNBS")
                        {
                            <button onclick="deleteUser(@user.Id, '@user.Username', @userOrderCount, @userCommentCount, @userCartCount)"
                                    class="admin-danger">
                                @L["Delete"]
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="admin-muted" style="margin-top:16px;">@L["NoUsersMatchFilter"]</p>
    }
 </div>

@if (totalPages > 1)
{
    <div class="admin-pagination">
        @if (currentPage > 1)
        {
            <a asp-action="Users" asp-route-search="@search" asp-route-role="@roleFilter" asp-route-page="@(currentPage - 1)">@L["Previous"]</a>
        }

        <span class="current">@L["PageOf", currentPage, totalPages]</span>

        @if (currentPage < totalPages)
        {
            <a asp-action="Users" asp-route-search="@search" asp-route-role="@roleFilter" asp-route-page="@(currentPage + 1)">@L["Next"]</a>
        }
    </div>
}

@Html.AntiForgeryToken()

<script>
    const usersUi = {
        promoted: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["UserPromotedToAdmin"].Value)),
        adminRemoved: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AdminRoleRemoved"].Value)),
        deleted: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeletedUser"].Value)),
        deleteTitle: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteUser"].Value)),
        deleteTemplate: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteUserConfirmation"].Value))
    };
    function makeAdmin(id) {
        fetch('/Admin/MakeAdmin', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id })
        }).then(() => {
            showToast(usersUi.promoted, "success");
            setTimeout(() => window.location.reload(), 450);
        });
    }

    function removeAdmin(id) {
        fetch('/Admin/RemoveAdmin', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id })
        }).then(() => {
            showToast(usersUi.adminRemoved, "success");
            setTimeout(() => window.location.reload(), 450);
        });
    }

    async function deleteUser(id, username, orderCount, commentCount, cartCount) {
        const summary = usersUi.deleteTemplate
            .replace('{0}', username)
            .replace('{1}', orderCount)
            .replace('{2}', commentCount)
            .replace('{3}', cartCount);

        const confirmed = await showConfirm(summary, usersUi.deleteTitle);
        if (!confirmed) return;

        fetch('/Admin/DeleteUser', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id })
        }).then(() => {
            const row = document.getElementById(`user-${id}`);
            if (row) {
                row.remove();
            }
            showToast(usersUi.deleted.replace('{0}', username), "success");
        });
    }
</script>
