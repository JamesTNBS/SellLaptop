@model IEnumerable<Laptop.Models.CartItem>

@functions {
    public string ResolveProductImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
        {
            return Url.Content("~/images/no-image.jpg");
        }

        if (imagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase) || imagePath.StartsWith("/"))
        {
            return imagePath;
        }

        return Url.Content("~/" + imagePath.TrimStart('/'));
    }
}

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var search = ViewBag.Search as string ?? string.Empty;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var currentProductImages = ViewBag.CurrentProductImages as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<style>
    .cart-product-cell {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .cart-product-cell img {
        width: 56px;
        height: 56px;
        object-fit: cover;
        border-radius: 10px;
        background: #f3f3f3;
    }

    .cart-product-name {
        font-weight: 700;
        color: #222;
    }
</style>

<h1>@L["ManageCartItems"]</h1>

<div class="admin-toolbar">
    <form method="get" class="admin-filters">
        <input type="text" name="search" value="@search" placeholder="@L["SearchCartPlaceholder"]" />
        <button type="submit">@L["Search"]</button>
    </form>

    <span class="admin-pill">@L["CartItemCountBadge", totalCount]</span>
</div>

<div class="admin-section">
    <table>
        <thead>
            <tr>
                <th>@L["User"]</th>
                <th>@L["Product"]</th>
                <th>@L["Price"]</th>
                <th>@L["Qty"]</th>
                <th>@L["Subtotal"]</th>
                <th>@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var image = currentProductImages.TryGetValue(item.ProductId, out var currentImage) &&
                    !string.IsNullOrWhiteSpace(currentImage)
                        ? currentImage
                        : item.Image;

                <tr id="cart-@item.Id">
                    <td>@item.Username</td>
                    <td>
                        <div class="cart-product-cell">
                            <img src="@ResolveProductImage(image)" alt="@item.Title" />
                            <div class="cart-product-name">@item.Title</div>
                        </div>
                    </td>
                    <td>@Formatter.Format(item)</td>
                    <td>
                        <input type="number" id="qty-@item.Id" value="@item.Quantity" min="1" style="width:72px; margin-right:8px;" />
                        <button onclick="updateCart(@item.Id)">@L["Update"]</button>
                    </td>
                    <td id="subtotal-@item.Id">@Formatter.FormatDisplay(Formatter.ToDisplayAmount(item) * item.Quantity)</td>
                    <td>
                        <button onclick="deleteCart(@item.Id)" class="admin-danger">
                            @L["Delete"]
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <p class="admin-muted" style="margin-top:16px;">@L["NoCartItemsMatchFilter"]</p>
    }
</div>

@if (totalPages > 1)
{
    <div class="admin-pagination">
        @if (currentPage > 1)
        {
            <a asp-action="CartItems" asp-route-search="@search" asp-route-page="@(currentPage - 1)">@L["Previous"]</a>
        }

        <span class="current">@L["PageOf", currentPage, totalPages]</span>

        @if (currentPage < totalPages)
        {
            <a asp-action="CartItems" asp-route-search="@search" asp-route-page="@(currentPage + 1)">@L["Next"]</a>
        }
    </div>
}

@Html.AntiForgeryToken()

<script>
    function updateCart(id) {
        const qtyInput = document.getElementById(`qty-${id}`);
        const qty = Number(qtyInput.value);

        fetch('/Admin/UpdateCartItem', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id, quantity: qty })
        }).then(() => window.location.reload());
    }

    async function deleteCart(id) {
        const confirmed = await showConfirm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteCartItemConfirmation"].Value)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["DeleteCartItem"].Value)));
        if (!confirmed) return;

        fetch('/Admin/DeleteCartItem', {
            method: 'POST',
            headers: {
                'RequestVerificationToken':
                    document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: new URLSearchParams({ id })
        }).then(() => {
            const row = document.getElementById(`cart-${id}`);
            if (row) {
                row.remove();
            }
            showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["CartItemDeleted"].Value)), "success");
        });
    }

    function highlight(rowId) {
        const row = document.getElementById(rowId);
        row.style.background = "#d4edda";
        setTimeout(() => row.style.background = "", 1000);
    }
</script>
