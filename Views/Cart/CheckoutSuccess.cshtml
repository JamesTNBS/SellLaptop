@model Laptop.Models.Order

@{
    var isPendingBankTransfer = string.Equals(Model.PaymentMethod, "Bank Transfer", StringComparison.OrdinalIgnoreCase)
        && string.Equals(Model.Status, "Pending Payment", StringComparison.OrdinalIgnoreCase);
}

<div class="checkout-success-page">
    <section class="checkout-success-card">
        <div class="checkout-success-header">
            <div>
                <p class="checkout-success-kicker">@L["OrderSaved"]</p>
                <h1>@L["OrderPlaced"]</h1>
                <p>@L["OrderPlacedMessage"]</p>
            </div>

            <span class="status-badge @(Model.Status == "Pending Payment" ? "status-pending-payment" : "status-pending")">
                @Formatter.TranslateOrderStatus(Model.Status)
            </span>
        </div>

        @if (isPendingBankTransfer)
        {
            <div class="bank-payment-panel">
                <div class="bank-payment-qr">
                    <img src="~/images/QR_code.jpg" alt="@L["BidvBankTransfer"]" />
                </div>

                <div class="bank-payment-details">
                    <h2>@L["BidvBankTransfer"]</h2>
                    <p>@L["BankTransferInstruction"]</p>

                    <div class="bank-payment-grid">
                        <div>
                            <span>@L["AccountName"]</span>
                            <strong>Thanabouasy Phonesavanh</strong>
                        </div>
                        <div>
                            <span>@L["AccountNumber"]</span>
                            <strong>8841398782</strong>
                        </div>
                        <div>
                            <span>@L["Amount"]</span>
                            <strong>@Formatter.FormatOrderTotal(Model)</strong>
                        </div>
                        <div>
                            <span>@L["TransferMessage"]</span>
                            <strong>ORDER-@Model.Id</strong>
                        </div>
                    </div>

                    <p class="bank-payment-note">
                        @L["BankTransferPendingNote"]
                    </p>
                </div>
            </div>
        }

        <div class="checkout-success-details">
            <div>
                <span>@L["OrderNumber"]</span>
                <strong>#@Model.Id</strong>
            </div>
            <div>
                <span>@L["Customer"]</span>
                <strong>@Model.FullName</strong>
            </div>
            <div>
                <span>@L["Email"]</span>
                <strong>@Model.Email</strong>
            </div>
            <div>
                <span>@L["Phone"]</span>
                <strong>@Model.Phone</strong>
            </div>
            <div>
                <span>@L["Payment"]</span>
                <strong>@Formatter.TranslatePaymentMethod(Model.PaymentMethod)</strong>
            </div>
            <div>
                <span>@L["Total"]</span>
                <strong>@Formatter.FormatOrderTotal(Model)</strong>
            </div>
        </div>

        <div class="checkout-success-address">
            <span>@L["Delivery"]</span>
            <strong>
                @Model.AddressLine1
                @if (!string.IsNullOrWhiteSpace(Model.AddressLine2))
                {
                    <br />@Model.AddressLine2
                }
                <br />@Model.City, @Model.StateOrProvince @Model.PostalCode
            </strong>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="checkout-success-notes">
                <span>@L["OrderNotes"]</span>
                <p>@Model.Notes</p>
            </div>
        }

        <div class="checkout-success-actions">
            @if (isPendingBankTransfer)
            {
                <a asp-controller="Cart" asp-action="ResumePayment" asp-route-id="@Model.Id" class="checkout-secondary-btn">@L["ContinuePayment"]</a>
            }
            <a asp-controller="Cart" asp-action="MyOrders" class="checkout-btn">@L["ViewMyOrders"]</a>
            <a asp-controller="Products" asp-action="Index" class="checkout-secondary-btn">@L["ContinueShopping"]</a>
        </div>
    </section>
</div>
